#version 450

// ============================================================================
// SVO Node structure - must match C++ struct layout
// ============================================================================
struct SVONode {
    uint childBase;      // First 4 bytes
    uint packedData;     // childMask (byte 0), material (byte 1), leafBlockIndex (bytes 2-3)
};

uint getChildMask(SVONode node) {
    return node.packedData & 0xFFu;
}

uint getMaterial(SVONode node) {
    return (node.packedData >> 8) & 0xFFu;
}

// ============================================================================
// Chunk info - contains AABB and LOD info
// ============================================================================
struct ChunkInfo {
    vec4 aabbMin;      // xyz = min, w = unused
    vec4 aabbMax;      // xyz = max, w = chunk size (256m)
    uint nodeOffset;
    uint nodeCount;
    uint maxDepth;     // LOD depth limit based on distance
    uint padding;
};

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(set = 0, binding = 1) readonly buffer ChunkDataBuffer {
    SVONode nodes[];
} chunkData;

layout(set = 0, binding = 2) readonly buffer ChunkInfoBuffer {
    ChunkInfo chunks[];
} chunkInfo;

layout(set = 0, binding = 3) uniform UniformBuffer {
    vec4 cameraPosV4;     // xyz = position
    vec4 cameraDirV4;     // xyz = direction
    vec4 cameraUpV4;      // xyz = up vector
    vec4 cameraRightFov;  // xyz = right vector, w = fov
    uint chunkCount;
    uint _pad1;
    uint _pad2;
    uint _pad3;
    vec4 sunDirV4;        // xyz = sun direction
} ubo;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ============================================================================
// Material colors
// ============================================================================
vec3 getMaterialColor(uint material) {
    if (material == 1u) return vec3(0.2, 0.8, 0.2);  // Grass - green
    if (material == 2u) return vec3(0.6, 0.4, 0.2);  // Dirt - brown
    if (material == 3u) return vec3(0.5, 0.5, 0.5);  // Stone - grey
    return vec3(1.0, 0.0, 1.0);                      // Unknown - magenta
}

// ============================================================================
// Debug visualization - chunk colors by distance/LOD
// ============================================================================
vec3 getChunkDebugTint(vec3 aabbMin, float chunkSize, uint maxDepth) {
    // Checkerboard pattern
    ivec3 chunkCoord = ivec3(floor(aabbMin / chunkSize));
    int checker = (chunkCoord.x + chunkCoord.y + chunkCoord.z) & 1;
    
    // Color based on LOD depth (8 = full detail, 1 = root only)
    vec3 lodColor;
    if (maxDepth >= 8u) {
        lodColor = checker == 0 ? vec3(0.9, 1.0, 1.0) : vec3(0.7, 0.9, 0.95);
    } else if (maxDepth == 7u) {
        lodColor = checker == 0 ? vec3(0.7, 0.85, 1.0) : vec3(0.5, 0.7, 0.9);
    } else if (maxDepth == 6u) {
        lodColor = checker == 0 ? vec3(0.5, 0.7, 1.0) : vec3(0.3, 0.5, 0.85);
    } else if (maxDepth == 5u) {
        lodColor = checker == 0 ? vec3(0.7, 0.5, 1.0) : vec3(0.55, 0.35, 0.85);
    } else if (maxDepth == 4u) {
        lodColor = checker == 0 ? vec3(1.0, 0.5, 0.9) : vec3(0.85, 0.35, 0.75);
    } else if (maxDepth == 3u) {
        lodColor = checker == 0 ? vec3(1.0, 0.5, 0.6) : vec3(0.85, 0.35, 0.45);
    } else if (maxDepth == 2u) {
        lodColor = checker == 0 ? vec3(1.0, 0.7, 0.4) : vec3(0.9, 0.55, 0.25);
    } else {
        lodColor = checker == 0 ? vec3(1.0, 0.9, 0.4) : vec3(0.9, 0.8, 0.25);
    }
    
    return lodColor;
}

// ============================================================================
// Ray-AABB intersection
// ============================================================================
bool intersectAABB(vec3 origin, vec3 dir, vec3 aabbMin, vec3 aabbMax, out float tmin, out float tmax) {
    vec3 invDir = 1.0 / dir;
    vec3 t0 = (aabbMin - origin) * invDir;
    vec3 t1 = (aabbMax - origin) * invDir;
    vec3 tsmall = min(t0, t1);
    vec3 tbig = max(t0, t1);
    tmin = max(max(tsmall.x, tsmall.y), tsmall.z);
    tmax = min(min(tbig.x, tbig.y), tbig.z);
    return tmax >= max(tmin, 0.0);
}

// ============================================================================
// Stackless SVO traversal with LOD depth limit
// ============================================================================
uint findMaterialInSVO(uint nodeOffset, uint nodeCount, vec3 localPos, float chunkSize, uint maxDepth) {
    if (nodeCount == 0u || nodeOffset >= chunkData.nodes.length()) {
        return 0u;
    }
    
    uint nodeIdx = nodeOffset;
    vec3 nodeMin = vec3(0.0);
    float nodeSize = chunkSize;
    
    for (uint depth = 0u; depth <= maxDepth && depth < 16u; depth++) {
        if (nodeIdx >= nodeOffset + nodeCount) {
            return 0u;
        }
        
        SVONode node = chunkData.nodes[nodeIdx];
        uint childMask = getChildMask(node);
        uint material = getMaterial(node);
        
        // If leaf node or at max depth, return material
        if (childMask == 0u || depth == maxDepth) {
            return material;
        }
        
        // Find which child octant contains the point
        float childSize = nodeSize * 0.5;
        
        uint childIdx = 0u;
        vec3 childMin = nodeMin;
        
        if (localPos.x >= nodeMin.x + childSize) {
            childIdx |= 1u;
            childMin.x += childSize;
        }
        if (localPos.y >= nodeMin.y + childSize) {
            childIdx |= 2u;
            childMin.y += childSize;
        }
        if (localPos.z >= nodeMin.z + childSize) {
            childIdx |= 4u;
            childMin.z += childSize;
        }
        
        // Check if this child exists
        if ((childMask & (1u << childIdx)) == 0u) {
            // Child doesn't exist - use parent's dominant material
            return material;
        }
        
        // Move to child
        nodeIdx = nodeOffset + node.childBase + childIdx;
        nodeMin = childMin;
        nodeSize = childSize;
    }
    
    return 0u;
}

// ============================================================================
// Main ray tracing kernel
// ============================================================================
void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputImage);
    
    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y) {
        return;
    }
    
    // Calculate ray direction
    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(imageSize);
    uv = uv * 2.0 - 1.0;
    
    float aspectRatio = float(imageSize.x) / float(imageSize.y);
    uv.y /= aspectRatio;
    uv.y *= -1.0;
    
    vec3 cameraPos = ubo.cameraPosV4.xyz;
    vec3 cameraDir = ubo.cameraDirV4.xyz;
    vec3 cameraUp = ubo.cameraUpV4.xyz;
    vec3 cameraRight = ubo.cameraRightFov.xyz;
    float fov = ubo.cameraRightFov.w;
    
    vec3 rayDir = normalize(cameraDir + cameraRight * uv.x * fov + cameraUp * uv.y * fov);
    vec3 rayOrigin = cameraPos;
    
    // Find closest chunk intersection
    float closestT = 1e10;
    uint hitChunkIdx = 0xFFFFFFFFu;
    
    for (uint i = 0u; i < ubo.chunkCount && i < 10000u; i++) {
        vec3 aabbMin = chunkInfo.chunks[i].aabbMin.xyz;
        vec3 aabbMax = chunkInfo.chunks[i].aabbMax.xyz;
        
        float tmin, tmax;
        if (intersectAABB(rayOrigin, rayDir, aabbMin, aabbMax, tmin, tmax)) {
            if (tmin < closestT && tmax > 0.0) {
                closestT = max(tmin, 0.0);
                hitChunkIdx = i;
            }
        }
    }
    
    // Default sky color
    vec3 color = vec3(0.4, 0.6, 0.9);
    
    if (hitChunkIdx != 0xFFFFFFFFu) {
        ChunkInfo chunk = chunkInfo.chunks[hitChunkIdx];
        vec3 aabbMin = chunk.aabbMin.xyz;
        float chunkSize = chunk.aabbMax.w;
        uint maxDepth = chunk.maxDepth;
        
        // Step into chunk
        float stepSize = chunkSize / float(1u << maxDepth) * 0.1;
        vec3 hitPoint = rayOrigin + rayDir * (closestT + stepSize);
        
        // Convert to chunk-local coordinates
        vec3 localPos = hitPoint - aabbMin;
        localPos = clamp(localPos, vec3(0.001), vec3(chunkSize - 0.001));
        
        // Find material in SVO with LOD
        uint material = findMaterialInSVO(chunk.nodeOffset, chunk.nodeCount, localPos, chunkSize, maxDepth);
        
        if (material != 0u) {
            vec3 materialColor = getMaterialColor(material);
            
            // Debug: blend with chunk tint
            vec3 chunkTint = getChunkDebugTint(aabbMin, chunkSize, maxDepth);
            color = mix(materialColor, chunkTint, 0.4);
            
            // Lighting
            vec3 sunDir = normalize(ubo.sunDirV4.xyz);
            float light = max(dot(vec3(0.0, 1.0, 0.0), sunDir), 0.0);
            color = color * (0.4 + 0.6 * light);
        } else {
            // Air region
            vec3 chunkTint = getChunkDebugTint(aabbMin, chunkSize, maxDepth);
            color = chunkTint * 0.3;
        }
    }
    
    imageStore(outputImage, pixelCoord, vec4(color, 1.0));
}
